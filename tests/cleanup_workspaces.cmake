cmake_policy(PUSH)
cmake_policy(SET CMP0054 NEW)
function(cleanup_workspaces fixture)
  file(GLOB_RECURSE markers "${fixture}/*/work-path")
  get_filename_component(temp_root "/tmp" REALPATH)
  foreach(marker IN LISTS markers)
    file(READ "${marker}" work)
    string(STRIP "${work}" work)
    get_filename_component(work_name "${work}" NAME)
    get_filename_component(root "${work}" DIRECTORY)
    get_filename_component(root_name "${root}" NAME)
    get_filename_component(parent "${root}" DIRECTORY)
    if(NOT work_name STREQUAL "work" OR NOT root_name MATCHES "^cpa-w-[A-Za-z0-9]+$"
       OR NOT parent STREQUAL temp_root)
      message(FATAL_ERROR "Unexpected retained work directory: ${work}")
    endif()
    file(REMOVE_RECURSE "${root}")
  endforeach()
endfunction()
cmake_policy(POP)
